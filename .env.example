# Bin Blast environment variables

# App
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Firebase Admin (server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (server + client)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# EmailJS (transactional email)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_PARTNER_APPLICATION=
# Copy the Template ID from EmailJS → Email Templates → Partner Approval
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_PARTNER_APPROVAL=template_lm4wzqr
NEXT_PUBLIC_EMAIL_LOGO_URL=https://www.binblastco.com/bin-blast-email-logo.png
NEXT_PUBLIC_ADMIN_EMAIL=binblastcompany@gmail.com

# QUO AI Call Center / SMS
# Get from Quo workspace: Settings → API → Generate API key
QUO_API_KEY=

# From Quo webhook details: Reveal signing secret (base64)
QUO_WEBHOOK_SIGNING_SECRET=

# Optional: Quo phone number ID for outbound SMS (auto-detected from API if omitted)
QUO_FROM_PHONE_NUMBER_ID=
