# Bin Blast environment variables

# App
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Firebase Admin (server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# QUO AI Call Center
# Get from Quo workspace: Settings → API → Generate API key
QUO_API_KEY=

# From Quo webhook details: Reveal signing secret (base64)
QUO_WEBHOOK_SIGNING_SECRET=
