rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "binblastcompany@gmail.com";
    }

    function isOperator() {
      return isAuthenticated() && request.auth.token.email == "keyjboone@gmail.com";
    }

    function isAdminOrOperator() {
      return isAdmin() || isOperator();
    }

    function isValidPhotoType(photoType) {
      return photoType in ["inside", "outside", "dumpster_pad", "sticker_placement"];
    }

    function isValidJobPhotoUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    function isAssignedToJob(jobId) {
      return firestore.exists(/databases/(default)/documents/scheduledCleanings/$(jobId))
        && firestore.get(/databases/(default)/documents/scheduledCleanings/$(jobId)).data.assignedEmployeeId == request.auth.uid;
    }

    // Training modules - public read, admin/operator write
    match /training-modules/{fileName} {
      allow read: if true;
      allow create, update: if isAdminOrOperator()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
      allow delete: if isAdminOrOperator();
    }

    // Job photos - employees upload before/after photos for assigned jobs
    match /job-photos/{jobId}/{photoType}/{fileName} {
      allow read: if isAuthenticated()
        && (isAdminOrOperator() || isAssignedToJob(jobId));

      allow create: if isAuthenticated()
        && isValidPhotoType(photoType)
        && isValidJobPhotoUpload()
        && (isAssignedToJob(jobId) || isAdminOrOperator());

      // Photos are immutable once uploaded
      allow update: if false;

      allow delete: if isAdminOrOperator();
    }

    // Employee W-9 documents - operator uploads, employee can read own file
    match /employees/{employeeId}/w9/{fileName} {
      allow read: if isAdminOrOperator()
        || (isAuthenticated() && request.auth.uid == employeeId);

      allow create: if isAdminOrOperator()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == "application/pdf"
            || request.resource.contentType.matches("image/.*"));

      allow update: if false;
      allow delete: if isAdminOrOperator();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
